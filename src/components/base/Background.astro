<style>
  html::before,
  html::after {
    content: "";
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -3;
    transition: opacity 0.5s ease-in-out;
    pointer-events: none;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  html::before {
    background-image: url("/src/assets/backgrounds/cpc-light.svg");
    opacity: 1;
  }

  html.dark::before {
    opacity: 0;
  }

  html::after {
    background-image: url("/src/assets/backgrounds/cpc-dark.svg");
    opacity: 0;
  }

  html.dark::after {
    opacity: 1;
  }

  .cpc-logo-bg {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60%;
    max-width: 600px;
    height: auto;
    opacity: 0.06;
    z-index: -1;
    pointer-events: none;
    transition: opacity 0.5s ease-in-out;
  }

  html.dark .cpc-logo-bg {
    opacity: 0.04;
  }

  .cpc-logo-top-right {
    position: fixed;
    top: 90px;
    right: 16px;
    width: 120px;
    height: auto;
    opacity: 0.85;
    z-index: -1;
    pointer-events: none;
    transition: opacity 0.5s ease-in-out;
  }

  @media (min-width: 640px) {
    .cpc-logo-top-right {
      width: 160px;
      right: 24px;
    }
  }

  @media (min-width: 1024px) {
    .cpc-logo-top-right {
      width: 200px;
      top: 100px;
      right: 32px;
    }
  }

  html.dark .cpc-logo-top-right {
    opacity: 0.7;
    filter: brightness(0) invert(1) drop-shadow(0 0 3px rgba(255,255,255,0.8));
  }

  .greca-marco {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
    pointer-events: none;
    opacity: 0;
    background-image:
      linear-gradient(to right, #39a2db 1px, transparent 1px),
      linear-gradient(to bottom, #39a2db 1px, transparent 1px);
    background-size: 40px 40px;
  }

  html.dark .greca-marco {
    opacity: 0.06;
  }
</style>

<!-- Greca: Marco institucional - solo modo oscuro -->
<div class="greca-marco" aria-hidden="true"></div>

<img
  src="/src/assets/images/utils/logo_cpc.png"
  alt=""
  class="cpc-logo-bg"
  aria-hidden="true"
/>

<img
  src="/src/assets/images/utils/PropuestaFinal_CPC_v1.png"
  alt=""
  class="cpc-logo-top-right"
  aria-hidden="true"
/>
