                  >
                    <FaFilePdf className="text-red-600 text-xl flex-shrink-0" />
                    <span class="text-gray-700 dark:text-gray-300"
                      >Ley General del Sistema Nacional Anticorrupción</span
                    >
                  </a>
                </li>
                <li>
                  <a
                    href="https://www.diputados.gob.mx/LeyesBiblio/pdf/LGRA.pdf"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-3 p-3 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
                  >
                    <FaFilePdf className="text-red-600 text-xl flex-shrink-0" />
                    <span class="text-gray-700 dark:text-gray-300"
                      >Ley General de Responsabilidades Administrativas</span
                    >
                  </a>
                </li>
                <li>
                  <a
                    href="https://www.diputados.gob.mx/LeyesBiblio/pdf/LGTAIP.pdf"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-3 p-3 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
                  >
                    <FaFilePdf className="text-red-600 text-xl flex-shrink-0" />
                    <span class="text-gray-700 dark:text-gray-300"
                      >Ley General de Transparencia y Acceso a la Información
                      Pública</span
                    >
                  </a>
                </li>
                <li>
                  <a
                    href="https://www.diputados.gob.mx/LeyesBiblio/pdf/LGPDPPSO.pdf"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-3 p-3 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
                  >
                    <FaFilePdf className="text-red-600 text-xl flex-shrink-0" />
                    <span class="text-gray-700 dark:text-gray-300"
                      >Ley General de Protección de Datos Personales</span
                    >
                  </a>
                </li>
                <li>
                  <a
                    href="https://www.diputados.gob.mx/LeyesBiblio/pdf/LFRCF_200521.pdf"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-3 p-3 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
                  >
                    <FaFilePdf className="text-red-600 text-xl flex-shrink-0" />
                    <span class="text-gray-700 dark:text-gray-300"
                      >Ley de Fiscalización y Rendición de Cuentas de la
                      Federación</span
                    >
                  </a>
                </li>
                <li>
                  <a
                    href="https://www.diputados.gob.mx/LeyesBiblio/pdf/LGA.pdf"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-3 p-3 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
                  >
                    <FaFilePdf className="text-red-600 text-xl flex-shrink-0" />
                    <span class="text-gray-700 dark:text-gray-300"
                      >Ley General de Archivos</span
                    >
                  </a>
                </li>
                <li>
                  <a
                    href="https://www.diputados.gob.mx/LeyesBiblio/pdf/CNPP.pdf"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-3 p-3 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
                  >
                    <FaFilePdf className="text-red-600 text-xl flex-shrink-0" />
                    <span class="text-gray-700 dark:text-gray-300"
                      >Código Nacional de Procedimientos Penales</span
                    >
                  </a>
                </li>
                <li>
                  <a
                    href="https://saetlax.org/wp-content/uploads/2023/10/Politica-Anticorrupcion-del-Estado-de-Tlaxcala.pdf"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-3 p-3 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
                  >
                    <FaFilePdf className="text-red-600 text-xl flex-shrink-0" />
                    <span class="text-gray-700 dark:text-gray-300"
                      >Política Nacional Anticorrupción</span
                    >
                  </a>
                </li>
              </ul>
            </div>

            <!-- Contenido Estatal -->
            <div class="tab-content hidden" id="estatal">
              <ul class="space-y-3">
                <li>
                  <a
                    href="https://congresodetlaxcala.gob.mx/archivo/leyes2020/pdf/5_constitucion_pol.pdf"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-3 p-3 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
                  >
                    <FaFilePdf className="text-red-600 text-xl flex-shrink-0" />
                    <span class="text-gray-700 dark:text-gray-300"
                      >Constitución Política del Estado Libre y Soberano de
                      Tlaxcala</span
                    >
                  </a>
                </li>
                <li>
                  <a
                    href="https://congresodetlaxcala.gob.mx/archivo/leyes2020/pdf/96_Ley_del_sistema.pdf"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-3 p-3 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
                  >
                    <FaFilePdf className="text-red-600 text-xl flex-shrink-0" />
                    <span class="text-gray-700 dark:text-gray-300"
                      >Ley del Sistema Anticorrupción del Estado de Tlaxcala</span
                    >
                  </a>
                </li>
                <li>
                  <a
                    href="https://saetlax.org/wp-content/uploads/2025/04/LTETLX-U-R-16-08-2024.pdf"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-3 p-3 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
                  >
                    <FaFilePdf className="text-red-600 text-xl flex-shrink-0" />
                    <span class="text-gray-700 dark:text-gray-300"
                      >Ley de Transparencia y Acceso a la Información Pública
                      para el Estado de Tlaxcala</span
                    >
                  </a>
                </li>
                <li>
                  <a
                    href="https://congresodetlaxcala.gob.mx/archivo/leyes2020/pdf/69_Ley_de_protecci.pdf"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-3 p-3 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
                  >
                    <FaFilePdf className="text-red-600 text-xl flex-shrink-0" />
                    <span class="text-gray-700 dark:text-gray-300"
                      >Ley de Protección de Datos Personales del Estado de
                      Tlaxcala</span
                    >
                  </a>
                </li>
                <li>
                  <a
                    href="https://congresodetlaxcala.gob.mx/archivo/leyes2020/pdf/41_Ley_de_fiscaliz.pdf"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-3 p-3 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
                  >
                    <FaFilePdf className="text-red-600 text-xl flex-shrink-0" />
                    <span class="text-gray-700 dark:text-gray-300"
                      >Ley de Fiscalización Superior y Rendición de Cuentas del
                      Estado de Tlaxcala</span
                    >
                  </a>
                </li>
                <li>
                  <a
                    href="https://congresodetlaxcala.gob.mx/archivo/leyes2020/pdf/7_Ley_de_adquisici.pdf"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-3 p-3 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
                  >
                    <FaFilePdf className="text-red-600 text-xl flex-shrink-0" />
                    <span class="text-gray-700 dark:text-gray-300"
                      >Ley de Adquisiciones, Arrendamientos y Servicios del
                      Estado de Tlaxcala</span
                    >
                  </a>
                </li>
              </ul>
            </div>

            <!-- Contenido Interno -->
            <div class="tab-content hidden" id="interno">
              <ul class="space-y-3">
                <li>
                  <a
                    href="https://saetlax.org/wp-content/uploads/2021/04/Reglamento-Interno-del-Comite-de-Participacion-Ciudadana.pdf"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-3 p-3 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors"
                  >
                    <FaFilePdf className="text-red-600 text-xl flex-shrink-0" />
                    <span class="text-gray-700 dark:text-gray-300"
                      >Reglamento Interno del Comité de Participación Ciudadana
                      del Sistema Anticorrupción del Estado de Tlaxcala</span
                    >
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .tab-content.hidden {
    display: none;
  }
</style>

<script>
  document.addEventListener("astro:page-load", initTabs);
  document.addEventListener("DOMContentLoaded", initTabs);

  function initTabs() {
    const tabs = document.querySelectorAll(".tab-btn");
    const contents = document.querySelectorAll(".tab-content");

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const targetId = tab.getAttribute("data-tab");
        if (!targetId) return;

        tabs.forEach((t) => {
          t.classList.remove("bg-blue-600", "text-white");
          t.classList.add("bg-gray-200", "dark:bg-gray-700");
        });

        tab.classList.add("bg-blue-600", "text-white");
        tab.classList.remove("bg-gray-200", "dark:bg-gray-700");

        contents.forEach((content) => {
          content.classList.add("hidden");
          content.classList.remove("active");
        });

        const targetContent = document.getElementById(targetId);
        if (targetContent) {
          targetContent.classList.remove("hidden");
          targetContent.classList.add("active");
        }
      });
    });
  }
</script>
