---
import CloseIcon from "./icons/CloseIcon.astro";
import {
  quickReplies,
  findRelevantResponse,
  getQuickReplyResponse,
} from "@lib/assistant-knowledge";

const botName = "CPC Asistente";
const welcomeMessage = `¡Hola! Soy el Asistente del CPC Tlaxcala. ¿En qué te puedo ayudar hoy?`;
---

<div
  id="chat-container"
  transition:persist
  class="container glass py-2 z-30 h-full w-full lg:rounded-lg flex flex-col"
  data-bot-name={botName}
  data-welcome-text={welcomeMessage}
  data-quick-replies={JSON.stringify(quickReplies)}
>
  <!-- Header of chat box -->
  <div
    class="flex items-center justify-between mb-3 border-b border-gray-200 pt-2 dark:border-gray-700"
  >
    <h4 class="text-txt-p dark:text-darkmode-txt-p">Chat • {botName}</h4>
    <button
      id="chat-close-btn"
      class="text-txt-p dark:text-darkmode-txt-p"
      aria-label="Cerrar chat"
    >
      <CloseIcon />
    </button>
  </div>
  <!-- Body chatbox here show history message -->
  <div
    id="chat-log"
    class="space-y-3 flex-1 overflow-y-auto pr-1"
    aria-live="polite"
    role="log"
  >
    <div class="flex items-start gap-3">
      <div
        class="h-8 w-8 flex items-center justify-center rounded-full bg-cyan-600 text-white shrink-0"
        aria-hidden="true"
      >
        🤖
      </div>
      <div
        class="max-w-[80%] rounded-lg px-3 py-2 bg-gray-100 dark:bg-cyan-950 text-txt-p dark:text-darkmode-txt-p shadow"
      >
        <p class="text-sm">
          <span class="font-semibold">{botName}:</span>
          {welcomeMessage}
        </p>
      </div>
    </div>
    <!-- Quick replies buttons -->
    <div class="flex flex-wrap gap-2 ml-11">
      <button
        class="quick-reply-btn text-xs px-3 py-1.5 rounded-full bg-cyan-100 dark:bg-cyan-900 text-cyan-700 dark:text-cyan-300 hover:bg-cyan-200 dark:hover:bg-cyan-800 transition-colors"
        data-quick-reply="atribuciones"
      >
        ¿Qué hace el CPC?
      </button>
      <button
        class="quick-reply-btn text-xs px-3 py-1.5 rounded-full bg-cyan-100 dark:bg-cyan-900 text-cyan-700 dark:text-cyan-300 hover:bg-cyan-200 dark:hover:bg-cyan-800 transition-colors"
        data-quick-reply="normativa"
      >
        Normativa
      </button>
      <button
        class="quick-reply-btn text-xs px-3 py-1.5 rounded-full bg-cyan-100 dark:bg-cyan-900 text-cyan-700 dark:text-cyan-300 hover:bg-cyan-200 dark:hover:bg-cyan-800 transition-colors"
        data-quick-reply="denuncia"
      >
        Denuncias
      </button>
    </div>
  </div>
  <!-- footer in this part contain input and button sende message  -->
  <div class="border-t border-gray-200 dark:border-gray-700 pt-2">
    <div class="flex items-center gap-2">
      <input
        id="chat-input"
        type="text"
        placeholder="Escribe tu mensaje..."
        class="flex-1 rounded-md border border-gray-300 dark:border-gray-700 bg-transparent px-3 py-2 text-sm text-txt-p dark:text-darkmode-txt-p focus:outline-none focus:ring-2 focus:ring-cyan-500"
        aria-label="Mensaje de chat"
      />
      <button
        id="chat-send-btn"
        type="button"
        class="inline-flex items-center gap-2 rounded-md bg-cyan-600 px-3 py-2 text-sm font-medium text-white hover:bg-cyan-700 focus:outline-none focus:ring-2 focus:ring-cyan-500"
        aria-label="Enviar mensaje"
      >
        Enviar
      </button>
    </div>
  </div>
  <script>
    /* @ts-nocheck */
    function setupChatUI() {
      const container = document.getElementById("chat-container");
      if (!container || container.dataset.setupDone === "true") return;
      const log = document.getElementById("chat-log");
      const inputEl = document.getElementById("chat-input");
      const sendBtn = document.getElementById("chat-send-btn");
      const closeBtn = document.getElementById("chat-close-btn");
      if (!(log instanceof HTMLDivElement)) return;
      if (!(inputEl instanceof HTMLInputElement)) return;
      if (!(sendBtn instanceof HTMLButtonElement)) return;
      if (!(closeBtn instanceof HTMLButtonElement)) return;
      const logEl = log;
      const input = inputEl;
      const sendBtnEl = sendBtn;
      const closeBtnEl = closeBtn;
      container.dataset.setupDone = "true";
      const botName = container.dataset.botName || "Bot";
      const welcomeText = container.dataset.welcomeText || "";
      const STORAGE_KEY = "chat:messages";
      const MAX_HISTORY = 150;

      function scrollToBottom() {
        requestAnimationFrame(() => {
          logEl.scrollTop = logEl.scrollHeight;
        });
      }

      function getMessages() {
        try {
          const raw = localStorage.getItem(STORAGE_KEY);
          const arr = raw ? JSON.parse(raw) : [];
          if (!Array.isArray(arr)) return [];
          return arr.length > MAX_HISTORY ? arr.slice(-MAX_HISTORY) : arr;
        } catch (_) {
          return [];
        }
      }

      // Initialize from storage
      const init = getMessages();
      if (init.length) {
        // Clear static welcome and render stored messages
        while (logEl.firstChild) logEl.removeChild(logEl.firstChild);
        for (let i = 0; i < init.length; i++) {
          const msg = init[i];
          if (!msg || typeof msg.text !== "string") continue;
          if (msg.isBot) {
            const botRow = document.createElement("div");
            botRow.className = "flex items-start gap-3";
            const botAvatar = document.createElement("div");
            botAvatar.setAttribute("aria-hidden", "true");
            botAvatar.className =
              "h-8 w-8 flex items-center justify-center rounded-full bg-cyan-600 text-white shrink-0";
            botAvatar.textContent = "🤖";
            const botBubble = document.createElement("div");
            botBubble.className =
              "max-w-[80%] rounded-lg px-3 py-2 bg-gray-100 dark:bg-cyan-950 text-txt-p dark:text-darkmode-txt-p shadow";
            const botP = document.createElement("p");
            botP.className = "text-sm";
            const botStrong = document.createElement("span");
            botStrong.className = "font-semibold";
            botStrong.textContent = botName + ":";
            botP.appendChild(botStrong);
            botP.appendChild(document.createTextNode(" " + msg.text));
            botBubble.appendChild(botP);
            botRow.appendChild(botAvatar);
            botRow.appendChild(botBubble);
            logEl.appendChild(botRow);
          } else {
            const userRow = document.createElement("div");
            userRow.className = "flex items-start gap-3 justify-end";
            const userBubble = document.createElement("div");
            userBubble.className =
              "max-w-[80%] rounded-lg px-3 py-2 bg-cyan-600 text-white shadow";
            const userP = document.createElement("p");
            userP.className = "text-sm";
            const userStrong = document.createElement("span");
            userStrong.className = "font-semibold";
            userStrong.textContent = "Tú:";
            userP.appendChild(userStrong);
            userP.appendChild(document.createTextNode(" " + msg.text));
            userBubble.appendChild(userP);
            const userAvatar = document.createElement("div");
            userAvatar.setAttribute("aria-hidden", "true");
            userAvatar.className =
              "h-8 w-8 flex items-center justify-center rounded-full bg-cyan-600 text-white shrink-0";
            userAvatar.textContent = "👤";
            userRow.appendChild(userBubble);
            userRow.appendChild(userAvatar);
            logEl.appendChild(userRow);
          }
        }
        scrollToBottom();
      } else {
        // No history, add quick replies
        const quickRepliesDiv = document.createElement("div");
        quickRepliesDiv.className = "flex flex-wrap gap-2 ml-11";

        const quickReplies = [
          { label: "¿Qué hace el CPC?", id: "atribuciones" },
          { label: "Normativa", id: "normativa" },
          { label: "Denuncias", id: "denuncia" },
        ];

        quickReplies.forEach((qr) => {
          const btn = document.createElement("button");
          btn.className =
            "quick-reply-btn text-xs px-3 py-1.5 rounded-full bg-cyan-100 dark:bg-cyan-900 text-cyan-700 dark:text-cyan-300 hover:bg-cyan-200 dark:hover:bg-cyan-800 transition-colors";
          btn.dataset.quickReply = qr.id;
          btn.textContent = qr.label;
          quickRepliesDiv.appendChild(btn);
        });

        logEl.appendChild(quickRepliesDiv);
      }

      function sendMessage() {
        const value = (input.value || "").trim();
        if (!value) return;
        // Append user bubble
        const userRow = document.createElement("div");
        userRow.className = "flex items-start gap-3 justify-end";
        const userBubble = document.createElement("div");
        userBubble.className =
          "max-w-[80%] rounded-lg px-3 py-2 bg-cyan-600 text-white shadow";
        const userP = document.createElement("p");
        userP.className = "text-sm";
        const userStrong = document.createElement("span");
        userStrong.className = "font-semibold";
        userStrong.textContent = "Tú:";
        userP.appendChild(userStrong);
        userP.appendChild(document.createTextNode(" " + value));
        userBubble.appendChild(userP);
        const userAvatar = document.createElement("div");
        userAvatar.setAttribute("aria-hidden", "true");
        userAvatar.className =
          "h-8 w-8 flex items-center justify-center rounded-full bg-cyan-600 text-white shrink-0";
        userAvatar.textContent = "👤";
        userRow.appendChild(userBubble);
        userRow.appendChild(userAvatar);
        logEl.appendChild(userRow);
        // Persist user message (trim to MAX_HISTORY)
        (function () {
          const arr = getMessages();
          arr.push({ isBot: false, text: value });
          if (arr.length > MAX_HISTORY) arr.splice(0, arr.length - MAX_HISTORY);
          try {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(arr));
          } catch (_) {}
        })();
        input.value = "";
        scrollToBottom();

        // Get intelligent response from knowledge base
        setTimeout(() => {
          const normalizedMessage = value.toLowerCase().trim();
          let reply = "";
          let link = "";
          let linkText = "";

          // Knowledge base (embedded for client-side use)
          const knowledgeBase = {
            atribuciones: {
              response:
                "El Comité de Participación Ciudadana (CPC) del Sistema Anticorrupción de Tlaxcala tiene las siguientes atribuciones principales:\n\n• **Coordinación e Información**: Participa en la Comisión Ejecutiva y accede a información técnica del Sistema Estatal.\n\n• **Propuestas y Mejora Regulatoria**: Emite opiniones sobre políticas integrales anticorrupción y propone proyectos de coordinación interinstitucional.\n\n• **Evaluación y Vigilancia**: Opina sobre el Programa Anual de Trabajo y monitorea el funcionamiento del Sistema Estatal Anticorrupción.\n\n• **Vinculación Ciudadana**: Promueve investigaciones con instituciones académicas y fortalece la contraloría social.",
              link: "/conocenos/atribuciones",
              linkText: "Ver atribuciones completas",
            },
            "no-hace": {
              response:
                "Es importante que conozcas nuestros límites legales:\n\n**Sobre la impartición de justicia**: El CPC NO tiene facultades para sancionar penalmente ni encarcelar a servidores públicos. No somos una autoridad judicial.\n\n**Sobre la investigación administrativa**: El Comité NO realiza investigaciones directas ni impone sanciones administrativas.\n\n**Lo que SÍ hacemos**: Brindamos orientación jurídica especializada para canalizar tu inquietud ante las autoridades competentes (Tribunal de Contasía, Fiscalía Anticorrupción, etc.).",
              link: "/conocenos/que-no-hace",
              linkText: "Más sobre nuestros límites",
            },
            integrantes: {
              response:
                "El CPC está integrado por ciudadanos con experiencia y prestigio en temas de transparencia, rendición de cuentas y combate a la corrupción:\n\n• **Mtro. Juan Carlos Cruz Jiménez** - Presidente\n• **Lcdo. Carlos Jonathan Pérez Ramírez** - Integrante\n• **Lcda. Guadalupe Ortega Gutiérrez** - Integrante\n• **Lcdo. Brandon Jiménez Enríquez** - Integrante\n• **Cargo pendiente por designar** - Integrante\n\nTodos son ciudadanos tlaxcaltecas con trayectoria en materia de transparencia y anticorrupción.",
              link: "/integrantes",
              linkText: "Ver integrantes completos",
            },
            denuncia: {
              response:
                "Si deseas denunciar un hecho de corrupción, el CPC te orienta sobre los canales adecuados:\n\n**Puedes denunciar ante:**\n• **Fiscalía Especializada en Combate a la Corrupción**: Para hechos que podrían constituir delitos penales.\n• **Contraloría del municipio o dependencia**: Para quejas contra servidores públicos.\n\nEl CPC no investiga ni sanciona, pero puede orientarte sobre cuál es la instancia correcta para tu caso.",
              link: "/conocenos/que-no-hace",
              linkText: "Más información",
            },
            normativa: {
              response:
                "El CPC se rige por normativa en tres niveles:\n\n**Nivel Estatal**:\n• Ley del Sistema Anticorrupción del Estado de Tlaxcala\n• Ley de Responsabilidades Administrativas\n\n**Nivel Nacional**:\n• Sistema Nacional Anticorrupción\n• Ley General del Sistema Anticorrupción\n\n**Nivel Internacional**:\n• Convenciones ONU contra la Corrupción\n• OECD Anticorruption Standards",
              link: "/normatividad",
              linkText: "Ver normativa completa",
            },
          };

          // Check for out-of-scope keywords
          const outOfScopeKeywords = [
            "investigar",
            "sancionar",
            "encarcelar",
            "castigar",
            "multar",
            "detener",
            "imponer",
            "delito",
            "juicio",
            "pena",
            "cárcel",
          ];
          const isOutOfScope = outOfScopeKeywords.some((k) =>
            normalizedMessage.includes(k),
          );

          // Search in knowledge base
          let found = null;

          if (isOutOfScope) {
            found = knowledgeBase["no-hace"];
          } else {
            // Check each topic
            for (const [id, data] of Object.entries(knowledgeBase)) {
              const keywords: Record<string, string[]> = {
                atribuciones: [
                  "atribuciones",
                  "funciones",
                  "hace",
                  "qué hace",
                  "competencias",
                  "facultades",
                  "trabajos",
                  "actividades",
                ],
                "no-hace": [
                  "no hace",
                  "no puede",
                  "investigar",
                  "sancionar",
                  "encarcelar",
                  "castigar",
                  "multar",
                  "detener",
                  "imponer",
                  "delito",
                  "juicio",
                  "pena",
                  "cárcel",
                  "límites",
                  "límites",
                  "qué no hace",
                ],
                integrantes: [
                  "integrantes",
                  "quiénes",
                  "integrado",
                  "miembros",
                  "integran",
                  "presidente",
                  "vocales",
                  "ciudadanos",
                  "composición",
                ],
                denuncia: [
                  "denuncia",
                  "denunciar",
                  "queja",
                  "reportar",
                  "corrupción",
                  "fraude",
                  "soborno",
                  "malversación",
                  "robo",
                  "abuso",
                  "irregularidad",
                ],
                normativa: [
                  "normativa",
                  "ley",
                  "leyes",
                  "reglamento",
                  "reglamentos",
                  "legal",
                  "legislación",
                  "derecho",
                  "estatal",
                  "nacional",
                  "internacional",
                ],
              };

              const topicKeywords = keywords[id] || [];
              if (topicKeywords.some((k) => normalizedMessage.includes(k))) {
                found = data;
                break;
              }
            }
          }

          if (found) {
            reply = found.response;
            link = found.link;
            linkText = found.linkText;
          } else {
            // Fallback response
            reply =
              "Gracias por tu consulta. Mi conocimiento se limita a la información pública, normativa y actividades del CPC Tlaxcala. ";
            reply += "Puedo ayudarte con información sobre:\n";
            reply += "• Las atribuciones y funciones del CPC\n";
            reply += "• Los límites de nuestra competencia\n";
            reply += "• Quiénes integran el Comité\n";
            reply += "• Cómo realizar denuncias\n";
            reply += "• La normativa aplicable\n\n";
            reply +=
              "Por favor, reformula tu pregunta o contacta directamente al CPC para temas específicos.";
          }

          // Append bot reply
          const botRow = document.createElement("div");
          botRow.className = "flex items-start gap-3";
          const botAvatar = document.createElement("div");
          botAvatar.setAttribute("aria-hidden", "true");
          botAvatar.className =
            "h-8 w-8 flex items-center justify-center rounded-full bg-cyan-600 text-white shrink-0";
          botAvatar.textContent = "🤖";
          const botBubble = document.createElement("div");
          botBubble.className =
            "max-w-[80%] rounded-lg px-3 py-2 bg-gray-100 dark:bg-cyan-950 text-txt-p dark:text-darkmode-txt-p shadow";
          const botP = document.createElement("p");
          botP.className = "text-sm whitespace-pre-wrap";
          const botStrong = document.createElement("span");
          botStrong.className = "font-semibold";
          botStrong.textContent = botName + ":";
          botP.appendChild(botStrong);
          botP.appendChild(document.createTextNode(" " + reply));
          botBubble.appendChild(botP);

          // Add link if available
          if (link && linkText) {
            const linkEl = document.createElement("a");
            linkEl.href = link;
            linkEl.className =
              "block mt-2 text-sm text-cyan-600 dark:text-cyan-400 hover:underline";
            linkEl.textContent = "→ " + linkText;
            linkEl.target = "_blank";
            botBubble.appendChild(linkEl);
          }

          botRow.appendChild(botAvatar);
          botRow.appendChild(botBubble);
          logEl.appendChild(botRow);
          // Persist bot message (trim to MAX_HISTORY)
          (function () {
            const arr = getMessages();
            arr.push({ isBot: true, text: reply });
            if (arr.length > MAX_HISTORY)
              arr.splice(0, arr.length - MAX_HISTORY);
            try {
              localStorage.setItem(STORAGE_KEY, JSON.stringify(arr));
            } catch (_) {}
          })();
          scrollToBottom();
        }, 300);
      }

      sendBtnEl.onclick = sendMessage;
      input.addEventListener("keydown", (e) => {
        if (e.key === "Enter" && !e.shiftKey) {
          e.preventDefault();
          sendMessage();
        }
      });

      // Quick replies functionality
      const quickReplyBtns = document.querySelectorAll(".quick-reply-btn");
      quickReplyBtns.forEach((btn) => {
        if (!(btn instanceof HTMLButtonElement)) return;
        btn.addEventListener("click", () => {
          const quickReplyId = btn.dataset.quickReply;
          if (!quickReplyId) return;

          const quickReplyLabels: Record<string, string> = {
            atribuciones: "¿Qué hace el CPC?",
            normativa: "Normativa",
            denuncia: "Denuncias",
          };

          const label = quickReplyLabels[quickReplyId] || "";

          // Simulate user clicking with that message
          const quickReplyResponses: Record<
            string,
            { response: string; link?: string; linkText?: string }
          > = {
            atribuciones: {
              response:
                "El Comité de Participación Ciudadana (CPC) del Sistema Anticorrupción de Tlaxcala tiene las siguientes atribuciones principales:\n\n• **Coordinación e Información**: Participa en la Comisión Ejecutiva y accede a información técnica del Sistema Estatal.\n\n• **Propuestas y Mejora Regulatoria**: Emite opiniones sobre políticas integrales anticorrupción y propone proyectos de coordinación interinstitucional.\n\n• **Evaluación y Vigilancia**: Opina sobre el Programa Anual de Trabajo y monitorea el funcionamiento del Sistema Estatal Anticorrupción.\n\n• **Vinculación Ciudadana**: Promueve investigaciones con instituciones académicas y fortalece la contraloría social.",
              link: "/conocenos/atribuciones",
              linkText: "Ver atribuciones completas",
            },
            normativa: {
              response:
                "El CPC se rige por normativa en tres niveles:\n\n**Nivel Estatal**:\n• Ley del Sistema Anticorrupción del Estado de Tlaxcala\n• Ley de Responsabilidades Administrativas\n\n**Nivel Nacional**:\n• Sistema Nacional Anticorrupción\n• Ley General del Sistema Anticorrupción\n\n**Nivel Internacional**:\n• Convenciones ONU contra la Corrupción\n• OECD Anticorruption Standards",
              link: "/normatividad",
              linkText: "Ver normativa completa",
            },
            denuncia: {
              response:
                "Si deseas denunciar un hecho de corrupción, el CPC te orienta sobre los canales adecuados:\n\n**Puedes denunciar ante:**\n• **Fiscalía Especializada en Combate a la Corrupción**: Para hechos que podrían constituir delitos penales.\n• **Tribunal de Contasía del Estado**: Para irregularidades en el uso de recursos públicos.\n• **Contraloría del municipio o dependencia**: Para quejas contra servidores públicos.\n\nEl CPC no investiga ni sanciona, pero puede orientarte sobre cuál es la instancia correcta para tu caso.",
              link: "/conocenos/que-no-hace",
              linkText: "Más información",
            },
          };

          const replyData = quickReplyResponses[quickReplyId];
          if (!replyData) return;

          // Add user message
          const userRow = document.createElement("div");
          userRow.className = "flex items-start gap-3 justify-end";
          const userBubble = document.createElement("div");
          userBubble.className =
            "max-w-[80%] rounded-lg px-3 py-2 bg-cyan-600 text-white shadow";
          const userP = document.createElement("p");
          userP.className = "text-sm";
          const userStrong = document.createElement("span");
          userStrong.className = "font-semibold";
          userStrong.textContent = "Tú:";
          userP.appendChild(userStrong);
          userP.appendChild(document.createTextNode(" " + label));
          userBubble.appendChild(userP);
          const userAvatar = document.createElement("div");
          userAvatar.setAttribute("aria-hidden", "true");
          userAvatar.className =
            "h-8 w-8 flex items-center justify-center rounded-full bg-cyan-600 text-white shrink-0";
          userAvatar.textContent = "👤";
          userRow.appendChild(userBubble);
          userRow.appendChild(userAvatar);
          logEl.appendChild(userRow);

          // Persist user message
          (function () {
            const arr = getMessages();
            arr.push({ isBot: false, text: label });
            if (arr.length > MAX_HISTORY)
              arr.splice(0, arr.length - MAX_HISTORY);
            try {
              localStorage.setItem(STORAGE_KEY, JSON.stringify(arr));
            } catch (_) {}
          })();

          scrollToBottom();

          // Add bot response
          setTimeout(() => {
            const botRow = document.createElement("div");
            botRow.className = "flex items-start gap-3";
            const botAvatar = document.createElement("div");
            botAvatar.setAttribute("aria-hidden", "true");
            botAvatar.className =
              "h-8 w-8 flex items-center justify-center rounded-full bg-cyan-600 text-white shrink-0";
            botAvatar.textContent = "🤖";
            const botBubble = document.createElement("div");
            botBubble.className =
              "max-w-[80%] rounded-lg px-3 py-2 bg-gray-100 dark:bg-cyan-950 text-txt-p dark:text-darkmode-txt-p shadow";
            const botP = document.createElement("p");
            botP.className = "text-sm whitespace-pre-wrap";
            const botStrong = document.createElement("span");
            botStrong.className = "font-semibold";
            botStrong.textContent = botName + ":";
            botP.appendChild(botStrong);
            botP.appendChild(document.createTextNode(" " + replyData.response));
            botBubble.appendChild(botP);

            if (replyData.link && replyData.linkText) {
              const linkEl = document.createElement("a");
              linkEl.href = replyData.link;
              linkEl.className =
                "block mt-2 text-sm text-cyan-600 dark:text-cyan-400 hover:underline";
              linkEl.textContent = "→ " + replyData.linkText;
              linkEl.target = "_blank";
              botBubble.appendChild(linkEl);
            }

            botRow.appendChild(botAvatar);
            botRow.appendChild(botBubble);
            logEl.appendChild(botRow);

            // Persist bot message
            (function () {
              const arr = getMessages();
              arr.push({ isBot: true, text: replyData.response });
              if (arr.length > MAX_HISTORY)
                arr.splice(0, arr.length - MAX_HISTORY);
              try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(arr));
              } catch (_) {}
            })();

            scrollToBottom();
          }, 300);
        });
      });

      // Confirm clear on close
      closeBtnEl.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopImmediatePropagation();
        const confirmed = confirm(
          "Al cerrar el chat se perderá el historial. ¿Deseas continuar?",
        );
        if (!confirmed) return;
        try {
          localStorage.removeItem(STORAGE_KEY);
        } catch (_) {}
        while (logEl.firstChild) logEl.removeChild(logEl.firstChild);
        if (welcomeText) {
          // Re-add welcome bubble
          const botRow = document.createElement("div");
          botRow.className = "flex items-start gap-3";
          const botAvatar = document.createElement("div");
          botAvatar.setAttribute("aria-hidden", "true");
          botAvatar.className =
            "h-8 w-8 flex items-center justify-center rounded-full bg-cyan-600 text-white shrink-0";
          botAvatar.textContent = "🤖";
          const botBubble = document.createElement("div");
          botBubble.className =
            "max-w-[80%] rounded-lg px-3 py-2 bg-gray-100 dark:bg-cyan-950 text-txt-p dark:text-darkmode-txt-p shadow";
          const botP = document.createElement("p");
          botP.className = "text-sm";
          const botStrong = document.createElement("span");
          botStrong.className = "font-semibold";
          botStrong.textContent = botName + ":";
          botP.appendChild(botStrong);
          botP.appendChild(document.createTextNode(" " + welcomeText));
          botBubble.appendChild(botP);
          botRow.appendChild(botAvatar);
          botRow.appendChild(botBubble);
          logEl.appendChild(botRow);
        }
        document.dispatchEvent(new CustomEvent("chat:request-close"));
      });

      scrollToBottom();
    }
    document.addEventListener("DOMContentLoaded", setupChatUI);
    document.addEventListener("astro:after-swap", setupChatUI);
  </script>
</div>
