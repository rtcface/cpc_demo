---
import type { IntegrantesEntry } from "@/types";
import { plainify } from "@lib/textConverter";
import { Image } from "astro:assets";
import Social from "@components/common/Social.astro";
import { FaFileAlt } from "react-icons/fa";

interface Props {
  entry: IntegrantesEntry;
  size?: "default" | "large";
}

const { entry, size = "default" }: Props = Astro.props;
const {
  title,
  image,
  imageAlt,
  social,
  curriculum = "/curriculum/pendiente-por-designar/",
} = entry.data;
const curriculumUrl = curriculum || null;
const bodyBrief = entry.body
  ? plainify(entry.body?.slice(0, size === "large" ? 80 : 50))
  : null;

const isLarge = size === "large";
---

<article
  class={`group flex flex-col items-center rounded-xl border border-gray-200 bg-transparent p-4 text-center transition-all duration-300 hover:border-primary/50 ${isLarge ? "w-[380px]" : "w-[260px]"}`}
>
  {/* Imagen - rectangular para ver completa */}
  {
    image && (
      <div
        class={`relative mb-4 overflow-hidden rounded-lg shadow-md ${isLarge ? "aspect-[3/4] w-full" : "aspect-[3/4] w-full"}`}
      >
        <Image
          class="h-full w-full object-cover"
          src={image}
          alt={imageAlt}
          width={isLarge ? 360 : 240}
          height={isLarge ? 480 : 320}
        />
      </div>
    )
  }

  {/* Nombre */}
  <h3
    class={`mb-1 font-semibold text-gray-900 transition-colors group-hover:text-primary ${isLarge ? "text-xl" : "text-base"}`}
  >
    {
      !curriculumUrl && (
        <a href={`${curriculumUrl}`} class="focus:outline-none">
          <span class="absolute inset-0" aria-hidden="true" />
          {title}
        </a>
      )
    }
    {curriculumUrl && <span>{title}</span>}
  </h3>

  {/* Cargo/Bio breve */}
  {
    bodyBrief && (
      <p class="mb-3 line-clamp-2 text-sm text-gray-500">{bodyBrief}</p>
    )
  }

  {/* Links + Botón en misma línea */}
  <div
    class="mt-auto flex w-full items-center justify-between gap-3 border-t border-gray-200 pt-3"
  >
    <div class="flex-shrink-0">
      <Social links={social} />
    </div>
    {
      curriculumUrl && (
        <a
          href={`${curriculumUrl}`}
          class="flex flex-shrink-0 items-center gap-1.5 rounded-full border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 transition-colors hover:border-primary hover:text-primary"
        >
          <FaFileAlt className="w-4 h-4" />
          <span>Ver Curriculum</span>
        </a>
      )
    }
  </div>
</article>
