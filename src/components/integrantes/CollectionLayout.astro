---
import type { IntegrantesEntry } from "@/types";
import BaseLayout from "@components/base/BaseLayout.astro";
import PageHeader from "@components/common/PageHeader.astro";
import IntegranteCard from "@components/integrantes/Card.astro";

interface Props {
  integranteIndex: IntegrantesEntry;
  entries: IntegrantesEntry[];
}

const { integranteIndex: integranteIndex, entries } = Astro.props;

const presidente = entries[0];
const restoIntegrantes = entries.slice(1);
---

<BaseLayout
  title={integranteIndex.data.title}
  description={integranteIndex.data.description}
>
  <PageHeader title={integranteIndex.data.title} />

  <section class="section-sm pb-6">
    <div class="container">
      {/* Presidente - nivel 1 (grande) */}
      <div class="flex justify-center mb-4">
        <IntegranteCard entry={presidente} size="large" />
      </div>

      {/* Línea divisoria pequeña */}
      <div class="flex justify-center mb-4">
        <div class="w-px h-6 bg-gradient-to-b from-primary to-gray-300"></div>
      </div>

      {/* Vocales - nivel 2 (una sola fila) */}
      <div class="flex flex-wrap justify-center gap-4">
        {restoIntegrantes.map((entry) => <IntegranteCard entry={entry} />)}
      </div>
    </div>
  </section>
</BaseLayout>
