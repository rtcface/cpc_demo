---
import BaseLayout from "@components/base/BaseLayout.astro";
import PageHeader from "@components/common/PageHeader.astro";
import { getCollection, render } from "astro:content";

const entries = await getCollection("nuestroCompromiso");
const missionEntry = entries.find((entry) => entry.id === "mision");
const visionEntry = entries.find((entry) => entry.id === "vision");

const { Content: MissionContent } = missionEntry
  ? await render(missionEntry)
  : { Content: null };
const { Content: VisionContent } = visionEntry
  ? await render(visionEntry)
  : { Content: null };
---

<BaseLayout
  title="Misión y Visión"
  description="Misión y Visión del Comité de Participación Ciudadana"
>
  <PageHeader title="Misión y Visión" />
  <section class="section-sm">
    <div class="container">
      <div class="row justify-center">
        <div class="glass rounded-lg p-8 md:col-10 lg:col-8">
          <h2 class="h3 mb-6 text-center">Misión</h2>
          <div
            class="prose dark:prose-invert max-w-none text-lg mb-8 text-gray-600 dark:text-gray-300"
          >
            {MissionContent && <MissionContent />}
          </div>

          <hr class="my-8 border-gray-300 dark:border-gray-600" />

          <h2 class="h3 mb-6 text-center">Visión</h2>
          <div
            class="prose dark:prose-invert max-w-none text-lg text-gray-600 dark:text-gray-300"
          >
            {VisionContent && <VisionContent />}
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
